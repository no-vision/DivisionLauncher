<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Division.Launcher.Desktop.MainWindow" Title="The Division Private — Launcher"
        Width="1080" Height="790" MinWidth="900" MinHeight="680" Background="#101820">
  <Grid RowDefinitions="*,Auto">
    <Grid x:Name="Workspace" ColumnDefinitions="280,*">
      <Border x:Name="ServerPanel" Background="#18232D" Padding="24">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,24">
            <TextBlock Text="THE DIVISION" FontSize="23" FontWeight="Bold" Foreground="#F28B30"/>
            <TextBlock Text="PRIVATE SERVER LAUNCHER" FontSize="11" LetterSpacing="1.3" Classes="Muted"/>
            <TextBlock Text="Your communities" FontSize="17" Margin="0,24,0,4"/>
            <Button Content="＋ Add server" Click="AddServer" HorizontalAlignment="Stretch"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,20,0,0">
            <Button Content="Check connection" Click="CheckConnection" HorizontalAlignment="Stretch"/>
            <Button x:Name="EditServerButton" Content="Edit connection" Click="EditServer" HorizontalAlignment="Stretch"/>
            <Button x:Name="RemoveServerButton" Content="Remove from launcher" Click="RemoveServer" HorizontalAlignment="Stretch"/>
            <TextBlock Text="Accounts belong to each server. Removing a connection leaves its accounts intact." Classes="Muted" FontSize="12"/>
          </StackPanel>
          <ListBox x:Name="Servers" SelectionChanged="ServerSelected" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="5" Margin="0,6">
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding ApiUrl}" FontSize="11" Classes="Muted" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="32,26">
        <StackPanel Spacing="8" Margin="0,0,0,22">
          <TextBlock x:Name="ServerTitle" Text="Welcome" Classes="Title"/>
          <TextBlock x:Name="ServerDetail" Text="Add a private server to create an account or sign in." Classes="Muted"/>
        </StackPanel>
        <TabControl x:Name="Pages" Grid.Row="1">
          <TabItem x:Name="AccountTab" Header="Account">
            <Grid>
            <ScrollViewer x:Name="LoginSection">
              <StackPanel Spacing="12" MaxWidth="480" HorizontalAlignment="Left" Margin="0,22,0,0">
                <TextBlock Text="Continue your journey" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Sign in with the account you created on this server." Classes="Muted"/>
                <TextBlock Text="Saved account" Margin="0,12,0,0"/>
                <Grid ColumnDefinitions="*,Auto">
                  <ComboBox x:Name="AccountChoices" HorizontalAlignment="Stretch" SelectionChanged="AccountSelected">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Username}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Content="Forget" Click="ForgetAccount" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="Username"/><TextBox x:Name="LoginUsername" PlaceholderText="Your username"/>
                <TextBlock Text="Password"/><TextBox x:Name="LoginPassword" PasswordChar="●"/>
                <CheckBox x:Name="RememberAccount" IsChecked="True" Content="Remember this account's username"/>
                <Button x:Name="SignInButton" Content="Sign in" Classes="Primary" Click="SignIn" HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="OpenRegistrationButton" Content="Create account…" Click="OpenRegistration"/>
                  <Button x:Name="OpenRecoveryButton" Content="Recover account…" Click="OpenRecovery"/>
                </StackPanel>
                <TextBlock Text="Passwords are used for this sign-in only and are not saved." Classes="Muted" FontSize="12"/>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="ProfileSection" IsVisible="False">
              <StackPanel Spacing="10" MaxWidth="500" HorizontalAlignment="Left" Margin="0,22,0,0">
                <Grid ColumnDefinitions="80,*">
                  <Border Width="68" Height="68" CornerRadius="8" Background="#263847" HorizontalAlignment="Left">
                    <Image x:Name="Avatar" Stretch="UniformToFill"/>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock x:Name="ProfileHeading" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProfileUsername" Classes="Muted"/>
                    <Button Content="Change picture…" Click="ChangePicture" Padding="10,4"/>
                  </StackPanel>
                </Grid>
                <Button x:Name="PlayButton" Content="Play" Click="Play" Classes="Primary" HorizontalAlignment="Stretch" Margin="0,14,0,4"/>
                <TextBlock x:Name="PlayHint" Text="Your saved characters and progress will load from this server." Classes="Muted"/>
                <Separator Margin="0,10"/>
                <TextBlock Text="Gamertag"/><TextBox x:Name="ProfileGamertag"/>
                <TextBlock Text="Name"/><TextBox x:Name="ProfileName"/>
                <TextBlock Text="Recovery email"/><TextBox x:Name="ProfileEmail"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                  <Button x:Name="SaveProfileButton" Content="Save profile" Click="SaveProfile"/>
                  <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut"/>
                </StackPanel>
                <TextBlock Text="Profile pictures appear in the launcher. Custom in-game pictures are not supported yet." Classes="Muted" FontSize="12"/>
              </StackPanel>
            </ScrollViewer>
            </Grid>
          </TabItem>
          <TabItem x:Name="FriendsTab" Header="Friends" IsVisible="False">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,22,0,0">
              <StackPanel Spacing="8">
                <TextBlock Text="Friends on this server" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Use your friend's private-server username. Requests require their acceptance." Classes="Muted"/>
                <TextBlock Text="Both players must be in game. Refresh, then invite an online friend; they accept inside the game." Classes="Muted"/>
              </StackPanel>
              <Grid x:Name="FriendControls" Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,12">
                <TextBox x:Name="FriendUsername" PlaceholderText="Exact username" MaxLength="32"/>
                <Button x:Name="FindFriendButton" Grid.Column="1" Content="Find player" Click="FindFriend" Margin="8,0,0,0"/>
                <Button x:Name="RefreshFriendsButton" Grid.Column="2" Content="Refresh" Click="RefreshFriends" Margin="8,0,0,0"/>
              </Grid>
              <TextBlock Grid.Row="2" x:Name="FriendsHint" Text="Refresh to load friends and pending requests." Classes="Muted" Margin="0,0,0,10"/>
              <ScrollViewer Grid.Row="3"><StackPanel x:Name="FriendsList" Spacing="10"/></ScrollViewer>
              <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                <Button x:Name="FriendsFirst" Content="First page" Click="RefreshFriends"/>
                <Button x:Name="FriendsNext" Content="Next page" Click="NextFriends" IsEnabled="False"/>
              </StackPanel>
            </Grid>
          </TabItem>
          <TabItem Header="Addons">
            <ScrollViewer>
              <StackPanel Spacing="14" Margin="0,22,0,0">
                <TextBlock Text="Your addons" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Choose addons for this server. Changes apply the next time you play." Classes="Muted"/>
                <Button Content="Rescan addons folder" Click="RescanAddons" HorizontalAlignment="Left"/>
                <StackPanel x:Name="AddonList" Spacing="14"/>
                <TextBlock x:Name="AddonHint" Classes="Muted" FontSize="12"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Installation">
            <ScrollViewer>
              <StackPanel Spacing="12" HorizontalAlignment="Stretch" Margin="0,22,0,0">
                <TextBlock Text="Game installation" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="PlatformHint" Text="Use your installed game files and the tested Proton 9.0-4 runtime." Classes="Muted"/>
                <TextBlock Text="Game folder"/>
                <Grid ColumnDefinitions="*,Auto"><TextBox x:Name="GameFolder"/><Button Grid.Column="1" Content="Browse…" Click="BrowseGame" Margin="8,0,0,0"/></Grid>
                <TextBlock x:Name="ProtonLabel" Text="Proton folder"/>
                <Grid x:Name="ProtonControls" ColumnDefinitions="*,Auto"><TextBox x:Name="ProtonFolder"/><Button Grid.Column="1" Content="Browse…" Click="BrowseProton" Margin="8,0,0,0"/></Grid>
                <Expander x:Name="AdapterSettings" Header="Adapter settings" IsExpanded="False">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Game adapter dependencies folder"/>
                    <Grid ColumnDefinitions="*,Auto"><TextBox x:Name="AdapterFolder"/><Button Grid.Column="1" Content="Browse…" Click="BrowseAdapter" Margin="8,0,0,0"/></Grid>
                  </StackPanel>
                </Expander>
                <Button Content="Check and save installation" Click="SaveInstallation" Margin="0,12,0,0"/>
                <Separator Margin="0,12"/>
                <TextBlock Text="Game display" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Saved per game installation and launcher profile. Applied at the next launch; each player can use a different size." Classes="Muted"/>
                <ComboBox x:Name="DisplayMode" SelectedIndex="0" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="Game default"/><ComboBoxItem Content="Windowed"/><ComboBoxItem Content="Fullscreen"/>
                </ComboBox>
                <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">
                  <TextBlock Text="Width (pixels)"/><TextBlock Grid.Column="2" Text="Height (pixels)"/>
                  <NumericUpDown x:Name="DisplayWidth" Grid.Row="1" Minimum="640" Maximum="16384" Value="1280" Increment="1" FormatString="0"/>
                  <NumericUpDown x:Name="DisplayHeight" Grid.Row="1" Grid.Column="2" Minimum="480" Maximum="16384" Value="720" Increment="1" FormatString="0"/>
                </Grid>
                <Button Content="Save display settings" Click="SaveDisplaySettings"/>
                <Separator Margin="0,12"/>
                <TextBlock Text="Launcher updates" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="LauncherVersionText" Classes="Muted"/>
                <TextBlock Text="Install a launcher release package from your trusted distributor. It takes effect after you close and reopen the launcher; accounts, game files and addons are kept." Classes="Muted"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Install update package…" Click="InstallUpdate"/>
                  <Button Content="Use bundled launcher" Click="UseBundledLauncher"/>
                </StackPanel>
                <TextBlock x:Name="UpdateStatus" Classes="Muted"/>

              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <Grid x:Name="DialogForms" IsVisible="False">
            <ScrollViewer x:Name="RegistrationForm">
              <StackPanel Spacing="9" MaxWidth="480" HorizontalAlignment="Left" Margin="0,22,0,0">
                <TextBlock Text="Start a new agent" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Create an account on the selected private server. You will create your character in the game." Classes="Muted"/>
                <TextBlock Text="Username" Margin="0,8,0,0"/><TextBox x:Name="NewUsername"/>
                <TextBlock Text="Gamertag · your in-game name"/><TextBox x:Name="NewGamertag"/>
                <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">
                  <TextBlock Text="Password · 8+ characters"/><TextBlock Grid.Column="2" Text="Confirm password"/>
                  <TextBox x:Name="NewPassword" Grid.Row="1" PasswordChar="●" Margin="0,6,0,0"/>
                  <TextBox x:Name="ConfirmPassword" Grid.Row="1" Grid.Column="2" PasswordChar="●" Margin="0,6,0,0"/>
                </Grid>
                <TextBlock Text="Name · optional"/><TextBox x:Name="NewName"/>
                <TextBlock Text="Recovery email · optional"/><TextBox x:Name="NewEmail" PlaceholderText="you@example.com"/>
                <Button x:Name="RegisterButton" Content="Create account and sign in" Classes="Primary" Click="Register" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="RecoveryForm">
              <StackPanel Spacing="12" MaxWidth="480" HorizontalAlignment="Left" Margin="0,22,0,0">
                <TextBlock Text="Recover your account" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="RecoveryHint" Classes="Muted" Text="The server sends a reset code to your saved email address."/>
                <TextBlock Text="Username or email"/><TextBox x:Name="RecoveryIdentity"/>
                <Button x:Name="RecoveryButton" Content="Request reset code" Click="RequestRecovery"/>
                <Separator Margin="0,14"/>
                <TextBlock Text="Reset code"/><TextBox x:Name="RecoveryCode" PasswordChar="●"/>
                <TextBlock Text="New password"/><TextBox x:Name="ResetPassword" PasswordChar="●"/>
                <TextBlock Text="Confirm new password"/><TextBox x:Name="ConfirmResetPassword" PasswordChar="●"/>
                <Button Content="Reset password" Click="CompleteRecovery"/>
              </StackPanel>
            </ScrollViewer>
    </Grid>
    <Border Grid.Row="1" Background="#0B1118" Padding="22,14">
      <Grid ColumnDefinitions="*,120">
        <TextBlock x:Name="StatusText" Text="Ready. Add a server to begin." TextWrapping="Wrap" VerticalAlignment="Center"/>
        <ProgressBar x:Name="BusyIndicator" Grid.Column="1" IsIndeterminate="True" IsVisible="False" Height="4" Margin="16,0,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
